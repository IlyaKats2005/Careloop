# Server-only configuration. Copy to .env, chmod 600, then fill locally.
# Never commit .env or put keys in public/.
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Alternative: AI_PROVIDER=openrouter, AI_MODEL=openrouter/free
OPENROUTER_API_KEY=

# Optional live Preprod sponsor relay. Also configure the same token on the server.
SPONSOR_SITE_URL=https://careloop-study-prototype.perasperaadastra3008.chatgpt.site
SPONSOR_RELAY_TOKEN=
# Absolute paths to PRIVATE files for a dedicated disposable Preprod sponsor wallet.
SPONSOR_SEED_FILE=
# Optional Blockfrost Preprod key file; otherwise the relay uses public Koios.
SPONSOR_BLOCKFROST_KEY_FILE=
SPONSOR_STATE_DIR=.local/sponsor-relay
SPONSOR_MAX_JOBS=4
SPONSOR_MAX_SPEND_ADA=100
